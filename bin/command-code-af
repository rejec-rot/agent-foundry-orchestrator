#!/bin/bash
# command-code-af - command-code CLI adapter for Agent Foundry Global Governance
#
# Single Source of Truth: $AF_GLOBAL_DIR/AGENTS.md (agent-foundry-global)
#
# Responsibilities:
#   1. resolve the command-code binary (never a hardcoded author-machine path)
#   2. verify the canonical governance exists and is readable, else fail closed
#   3. export adapter metadata env vars
#   4. inject the canonical governance into the PROMPT
#   5. pass through all original args; preserve exit code via exec
#
# Why the prompt and not a flag: command-code exposes no system-prompt option in
# `--help` (unlike cline's -s/--system or claude's --append-system-prompt-file).
# The adapter always passes the prompt as the LAST argument, so the prefix is
# applied there. Called with no positional argument at all, this refuses rather
# than silently running ungoverned.

set -u

CC_BIN="${COMMAND_CODE_BIN:-$(command -v command-code 2>/dev/null || true)}"
if [ -z "$CC_BIN" ] || [ ! -x "$CC_BIN" ]; then
    # cmd / cmdc / commandcode are aliases of the same CLI.
    for alias in cmd cmdc commandcode; do
        candidate="$(command -v "$alias" 2>/dev/null || true)"
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then CC_BIN="$candidate"; break; fi
    done
fi
if [ -z "$CC_BIN" ] || [ ! -x "$CC_BIN" ]; then
    echo "command-code-af: command-code binary not found on PATH (aliases: cmd, cmdc, commandcode)" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GOV_DIR="${AF_GLOBAL_DIR-$(cd "$SCRIPT_DIR/../../agent-foundry-global" 2>/dev/null && pwd || true)}"
CANONICAL="${AF_CANONICAL_AGENTS_MD-${GOV_DIR:+$GOV_DIR/AGENTS.md}}"

if [ -z "$CANONICAL" ] || [ ! -r "$CANONICAL" ]; then
    echo "command-code-af: canonical governance not readable: ${CANONICAL:-<unresolved>}" >&2
    exit 2
fi

GOV_SHA=$(sha256sum "$CANONICAL" | cut -d' ' -f1)
if [ -z "$GOV_SHA" ]; then
    echo "command-code-af: failed to compute governance sha256" >&2
    exit 2
fi

export AGENT_FOUNDRY_GOVERNANCE_SHA256="$GOV_SHA"
export AGENT_FOUNDRY_GLOBAL_AGENTS="$CANONICAL"

if [ "$#" -lt 1 ]; then
    echo "command-code-af: no arguments; refusing to run without a prompt to govern" >&2
    exit 2
fi

LAST="${!#}"
case "$LAST" in
    -*)
        echo "command-code-af: last argument looks like a flag (${LAST}); refusing to inject governance into it" >&2
        exit 2
        ;;
esac

GOV_TEXT="$(cat "$CANONICAL")"
ARGS=("$@")
ARGS[$#-1]="$(printf '%s\n\n---\n\n%s' "$GOV_TEXT" "$LAST")"

exec "$CC_BIN" "${ARGS[@]}"
