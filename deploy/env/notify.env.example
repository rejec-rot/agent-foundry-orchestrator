# Boundary notification retry - PRIVATE configuration (example; contains NO real values)
#
# Copy to <AF_CONFIG_DIR>/notify.env, fill in the real target, and chmod 600. This file is never
# committed with real values. The default below is OFF.

# off | dry-run | live
AF_BOUNDARY_NOTIFY_MODE=off

# Where the alerts live (shared with the boundary, read-only for this scheduler).
# AF_BOUNDARY_ALERTS_FILE=/var/lib/agent-foundry/boundary-alerts.jsonl

# Target and credentials: SET THESE ONLY IN THE PRIVATE COPY, never here.
# AF_BOUNDARY_NOTIFY_WEBHOOK=__SET_IN_THE_PRIVATE_FILE__
# AF_BOUNDARY_NOTIFY_TOKEN=__SET_IN_THE_PRIVATE_FILE__
# AF_BOUNDARY_NOTIFY_FEISHU_SECRET=__SET_IN_THE_PRIVATE_FILE__
# AF_BOUNDARY_NOTIFY_FORMAT=feishu-card
# AF_BOUNDARY_NOTIFY_MAX_ATTEMPTS=5
# AF_BOUNDARY_NOTIFY_RETRY_BASE_MS=60000
# AF_BOUNDARY_NOTIFY_RETRY_MAX_MS=1800000
