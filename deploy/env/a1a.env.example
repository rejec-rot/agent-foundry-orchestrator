# A1a automatic boundary recovery - PRIVATE configuration (example; contains NO real values)
#
# Copy to <AF_CONFIG_DIR>/a1a.env, fill in the real paths, and chmod 600. This file is never
# committed with real values. The default below is OFF: with AF_A1A_MODE=off the scheduler does
# not read, lock or attempt any asset.

# off | dry-run | live   (anything unrecognised is treated as off)
AF_A1A_MODE=off

# Explicit asset allowlist (exact canonical_dir + cas_dir). Unset = no asset is ever considered.
# AF_A1A_ALLOWLIST_FILE=/etc/agent-foundry/a1a-allowlist.json

# Scheduler state (epoch budget, backoff, terminal phases). Must be on durable storage.
# AF_A1A_QUEUE_FILE=/var/lib/agent-foundry/a1a/state.json

# Recovery audit root (epochs + per-recovery records); also the default location of a1a/.
# AF_BOUNDARY_AUDIT_DIR=/var/lib/agent-foundry/audit

# Cadence and bounds.
# AF_A1A_INTERVAL_MS=300000
# AF_A1A_MAX_ATTEMPTS=3
# AF_A1A_RETRY_BASE_MS=60000
# AF_A1A_RETRY_MAX_MS=1800000
# AF_A1A_LOCK_TTL_MS=600000

# Recovery notification is off by default and never affects success/failure.
# AF_A1A_NOTIFY_ON_SUCCESS=0
