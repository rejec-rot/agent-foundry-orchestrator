# TypeSafe / Jev decision model - PRIVATE configuration (example; contains NO real values)
#
# Copy to <config dir>/decision.env, fill in the real key, and chmod 600. The real file must
# NEVER be committed: keep it OUTSIDE the repository (e.g. /etc/agent-foundry/decision.env or
# ~/.config/agent-foundry/decision.env) or rely on the repository's `*.env` ignore rule.
#
# The decision model is ADVISORY only and default OFF. With AF_DECISION_MODEL=off the adapter
# never touches the network and every caller keeps its deterministic behaviour.

# off | jev   (anything unrecognised is treated as off)
AF_DECISION_MODEL=off

# The API key. SET THIS ONLY IN THE PRIVATE COPY, never here.
# AF_TYPESAFE_API_KEY=__SET_IN_THE_PRIVATE_FILE__

# Endpoint and model id. The endpoint defaults to the official TypeSafe API inside the code, so it
# is intentionally NOT written here (deploy/ must not carry URLs). Override only for testing.
# AF_TYPESAFE_MODEL=jev-latest
# AF_TYPESAFE_TIMEOUT_MS=5000
