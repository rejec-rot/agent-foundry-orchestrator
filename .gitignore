# Dependency directories
node_modules/

# Runtime locks and transient process handles
locks/*
!locks/.gitkeep
runtime/runs/*
!runtime/runs/.gitkeep
runtime/archive/*
runtime/operator-activity/*
runtime/operator-input/*
runtime/operator-received/*

# Per-instance runtime state (recreated on first start, never committed).
# The circuit-breaker state is per-machine: any real run rewrites it (dirtying
# the tree), a committed OPEN_MANUAL_RESET would ship a banned executor as the
# "factory default", and its last_reset field records who reset a breaker and
# why - which must not end up in public history. The guard treats a missing file
# as "first start, everything CLOSED", so not tracking it changes nothing.
runtime/scheduler.json
runtime/executor-safety-state.json
# The initialisation marker written alongside the safety state. Without this
# entry a test run leaves it untracked, and a committed marker would make a
# fresh checkout look like "state existed and was deleted" -> all breakers
# fail closed on first start.
runtime/executor-safety-state.json.initialized
# Any per-instance state file a future safety component may add.
runtime/*.initialized

# Historical execution tasks (keep only standard templates)
tasks/*.json
!tasks/task-template.json
!tasks/demo-task.json
!tasks/.gitkeep

# Runtime generated event logs (auto-created on run)
runtime/executor-runtime-events.jsonl

# Sensitive credentials & environment files
.env
.env.*
*.pem
*.key
*.cert
*.token

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
